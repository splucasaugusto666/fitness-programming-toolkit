{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/splucasaugusto666/fitness-programming-toolkit/main/schemas/program-1.0.schema.json",
  "title": "FPTK program format 1.0",
  "description": "Structural validation only; the Python runtime additionally enforces unique IDs, aggregate and input limits, and lexical numeric constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "title",
    "weeks",
    "sessions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "program_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/name"
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]|^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?![\\s\\S])"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]|^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?![\\s\\S])"
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "name",
        "day_of_week",
        "exercises"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "day_of_week": {
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_id",
        "name",
        "sets"
      ],
      "properties": {
        "exercise_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/set"
          }
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reps",
        "rest_seconds"
      ],
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "rest_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7200
        },
        "load_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5000
        },
        "rpe": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
